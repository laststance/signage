{
  "name": "signage",
  "version": "1.4.8",
  "description": "Self Screen Saver App",
  "main": "./out/main/main.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guasam/electron-react-app"
  },
  "author": "Ryota Murakami <dojce1048@gmail.com> (https://github.com/ryota-murakami)",
  "scripts": {
    "dev": "electron-vite dev -w",
    "dev:debug": "electron-vite dev -w -- --remote-debugging-port=9222",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-test-module-mocks --test scripts/*.test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && PATH=\"scripts/bin:$PATH\" electron-builder --mac",
    "build:mac:intel": "electron-vite build && PATH=\"scripts/bin:$PATH\" electron-builder --mac --x64",
    "build:mac:apple": "electron-vite build && PATH=\"scripts/bin:$PATH\" electron-builder --mac --arm64",
    "prepare": "husky",
    "prettier": "prettier --ignore-unknown --write ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.62.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-ts-prefixer": "^5.1.0",
    "framer-motion": "^14.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "volta": {
    "node": "26.12.1"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
