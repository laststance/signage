  "scripts": {
    "dev": "electron-vite dev -w",
    "dev:debug": "electron-vite dev -w -- --remote-debugging-port=9222",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
