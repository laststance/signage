    "electron-log": "^5.4.4",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-ts-prefixer": "^5.0.0",
    "framer-motion": "^13.2.0",
    "husky": "^9.1.7",
