{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "app/index.d.ts",
    "app/**/*",
    "lib/**/*",
    "lib/preload/*.d.ts",
    "resources/**/*"
  ],
  "compilerOptions": {
    "paths": {
      "@/app/*": ["./app/*"],
      "@/lib/*": ["./lib/*"],
      "@/resources/*": ["./resources/*"]
    }
  }
}
